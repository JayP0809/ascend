# =============================================================================
# Ascend — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# AI — Groq (required for live analysis; demo mode works without this)
# Free tier: https://console.groq.com
# No GROQ_API_KEY → app runs in demo-only mode (safe, no billing risk)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# Model to use for all Groq API calls.
# Default: openai/gpt-oss-20b (Groq's free-tier model as of 2024)
# Change this if Groq updates their free model offering.
GROQ_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Database — Neon PostgreSQL (required for auth + persistent analyses)
# Free tier: https://neon.tech (1 project, 0.5 GB, 190 compute hours/month)
# No DATABASE_URL → app runs in stateless demo mode
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js v5 — Google OAuth (required for user sign-in)
# No AUTH_SECRET / AUTH_GOOGLE_ID → auth UI hidden, app runs in dev-bypass mode
# 1. Generate AUTH_SECRET: npx auth secret (or openssl rand -base64 32)
# 2. Create OAuth credentials at https://console.cloud.google.com
#    Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Show auth UI in the navbar (must be "true" when Google credentials are set)
NEXT_PUBLIC_AUTH_ENABLED=false

# -----------------------------------------------------------------------------
# Admin (optional)
# Email address of the admin user. Admins bypass per-user monthly quota
# but their usage is still tracked. Must be a server-side env var only —
# never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Quota (optional — defaults shown)
# -----------------------------------------------------------------------------

# Max live AI analyses per user per calendar month.
# Default: 5. Raise for heavier usage; lower to conserve Groq free-tier tokens.
ANALYSIS_QUOTA_PER_MONTH=5

# Global cap across ALL users combined per calendar month.
# Prevents exhausting Groq's free tier (~500K tokens/day, 30 RPM) during traffic spikes.
# Default: 50 (≈250 Groq calls, ≈375K tokens). App returns 503 when reached.
GLOBAL_MONTHLY_ANALYSIS_QUOTA=50
