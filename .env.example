# Ascend 2.0 — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.
# Add all variables to Vercel's Environment Variables dashboard for deployment.

# ---------------------------------------------------------------------------
# AI — Groq (required for live analysis; demo mode works without it)
# Get your free key at https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL (required for persistent storage)
# Get a free connection string at https://neon.tech
# Format: postgresql://user:password@host.neon.tech/dbname?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=your_neon_connection_string_here

# ---------------------------------------------------------------------------
# Authentication — Clerk (required for user accounts and Google sign-in)
# Get keys at https://clerk.com → Your app → API Keys
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key_here

# ---------------------------------------------------------------------------
# Quota — configurable monthly analysis limit (optional; defaults to 5)
# ---------------------------------------------------------------------------
ANALYSIS_QUOTA_PER_MONTH=5

# ---------------------------------------------------------------------------
# Administrator — Clerk user ID exempt from monthly quota (optional)
# Set to your Clerk user ID to bypass the per-user monthly analysis limit.
# How to find your Clerk user ID:
#   1. Sign in to your app locally after Clerk is configured.
#   2. Visit Clerk dashboard → Users → click your account → copy "User ID".
#      It starts with "user_" (e.g. user_2abc123XYZ).
#   OR: Call GET /api/auth/me (once you add that route) while signed in.
# SERVER-SIDE ONLY — never expose this value client-side or in Git.
# ---------------------------------------------------------------------------
ADMIN_CLERK_USER_ID=user_your_clerk_user_id_here

# ---------------------------------------------------------------------------
# Analytics — PostHog (optional; product event tracking)
# Get keys at https://posthog.com → Project → Settings → Project API Key
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Rate limiting — Upstash Redis (optional; burst protection)
# Get keys at https://upstash.com → Create Database → REST API
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ---------------------------------------------------------------------------
# Error monitoring — Sentry (optional)
# Get DSN at https://sentry.io → Your project → Settings → Client Keys
# ---------------------------------------------------------------------------
SENTRY_DSN=https://your_key@sentry.io/your_project_id
