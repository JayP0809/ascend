    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "uuid": "^9.0.1",
    "zod": "^4.6.7"
