{
  "name": "ascend",
  "version": "1.0.0",
  "description": "AI-powered career navigation platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "npx tsx evals/runner.ts",
    "eval:live": "RUN_EVALS=true npx tsx evals/runner.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
